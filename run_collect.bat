@echo off
REM ============================================================
REM  독도(22441) 파고부이 데이터 수집 - 백그라운드 실행용 배치파일
REM
REM  이 파일을 더블클릭하면:
REM  - 새 콘솔 창이 하나 뜨면서 거기서 수집 스크립트가 계속 돌아갑니다.
REM  - 그 창은 그냥 둔 채로, VS Code나 다른 작업을 하시면 됩니다.
REM  - 1년치가 완료될 때마다 진행 상황 팝업이 뜹니다 (안 눌러도 계속 진행됨).
REM  - 창을 닫지 않는 이상 계속 실행되며, 끄고 싶으면 그 창에서 Ctrl+C.
REM ============================================================

REM 배치파일이 있는 폴더로 이동 (스크립트, CSV, 체크포인트가 다 같은 폴더에 있어야 함)
cd /d "%~dp0"

REM 새 창을 띄워서 그 안에서 파이썬 스크립트 실행
REM   start "제목" cmd /k  ->  새 창 열고, 스크립트 끝나거나 오류 나도 창은 안 닫힘 (로그 확인용)
start "독도 데이터 수집 (닫지 마세요)" cmd /k python collect_full_history.py

echo 새 창에서 수집이 시작되었습니다. 이 창은 닫으셔도 됩니다.
pause
